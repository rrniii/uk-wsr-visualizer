# Copy this block into ~/.aws/credentials on the account that runs live sync.
# Do not commit the real access key or secret.
#
# The toolkit config uses:
#   aws_profile = "ncas-radar-o"
#
# After creating the S3 access key in the JASMIN Object Store Portal, replace
# the placeholders below.

[ncas-radar-o]
aws_access_key_id = PASTE_JASMIN_S3_TOKEN_ID_HERE
aws_secret_access_key = PASTE_JASMIN_S3_SECRET_KEY_HERE
