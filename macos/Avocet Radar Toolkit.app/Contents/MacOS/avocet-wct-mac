#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$APP_ROOT/Resources/repo"
APP_SUPPORT="$HOME/Library/Application Support/Avocet Radar Toolkit"
DATA_DIR="$APP_SUPPORT/data"
VENV_DIR="$APP_SUPPORT/venv"
LOG_FILE="$APP_SUPPORT/avocet-radar-toolkit.log"
PORT="${AVOCET_WCT_MAC_PORT:-8765}"
BASE_URL="http://127.0.0.1:$PORT"
CACHE_TTL_SECONDS="${AVOCET_WCT_REMOTE_CACHE_TTL_SECONDS:-3600}"
CACHE_MAX_BYTES="${AVOCET_WCT_REMOTE_CACHE_MAX_BYTES:-26843545600}"
SERVER_PID=""
STARTED_SERVER=0

REMOTE_BASE="${AVOCET_WCT_OBJECT_STORE_EXTERNAL_BASE:-https://ncas-radar-o.s3-ext.jc.rl.ac.uk/avocet-uk-radar-public}"
REMOTE_CATALOG="${AVOCET_WCT_REMOTE_CATALOG_URL:-$REMOTE_BASE/uk-radar/catalog/inventory/raw-volume/chenies/2018/20180401/catalog.json}"

mkdir -p "$APP_SUPPORT" "$DATA_DIR"

log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOG_FILE"
}

ensure_venv() {
  if [ ! -x "$VENV_DIR/bin/python" ]; then
    log "creating venv at $VENV_DIR"
    /usr/bin/arch -arm64 /usr/bin/python3 -m venv "$VENV_DIR"
  fi
  if ! /usr/bin/arch -arm64 "$VENV_DIR/bin/python" -c 'import fastapi, uvicorn, h5py, numpy, PIL, tomli, eval_type_backport' >/dev/null 2>&1; then
    log "runtime dependency import failed; recreating venv at $VENV_DIR"
    rm -rf "$VENV_DIR"
    /usr/bin/arch -arm64 /usr/bin/python3 -m venv "$VENV_DIR"
    log "installing runtime dependencies into venv"
    /usr/bin/arch -arm64 "$VENV_DIR/bin/python" -m pip install --no-cache-dir --upgrade pip >> "$LOG_FILE" 2>&1
    /usr/bin/arch -arm64 "$VENV_DIR/bin/python" -m pip install --no-cache-dir fastapi 'uvicorn[standard]' h5py numpy pillow tomli eval_type_backport >> "$LOG_FILE" 2>&1
  fi
}

server_ready() {
  /usr/bin/curl -fsS "$BASE_URL/api/status" >/dev/null 2>&1
}

start_server() {
  if server_ready; then
    log "server already running at $BASE_URL"
    return
  fi
  log "starting server at $BASE_URL with remote catalog $REMOTE_CATALOG"
  nohup env \
    PYTHONPATH="$REPO_ROOT/src" \
    AVOCET_WCT_DATA_DIR="$DATA_DIR" \
    AVOCET_WCT_CATALOG="$DATA_DIR/catalog.json" \
    AVOCET_WCT_REMOTE_CATALOG_URL="$REMOTE_CATALOG" \
    AVOCET_WCT_OBJECT_STORE_EXTERNAL_BASE="$REMOTE_BASE" \
    AVOCET_WCT_REMOTE_CACHE_TTL_SECONDS="$CACHE_TTL_SECONDS" \
    AVOCET_WCT_REMOTE_CACHE_MAX_BYTES="$CACHE_MAX_BYTES" \
    /usr/bin/arch -arm64 "$VENV_DIR/bin/python" -m avocet_radar_toolkit.cli api --host 127.0.0.1 --port "$PORT" \
    >> "$LOG_FILE" 2>&1 &
  SERVER_PID="$!"
  STARTED_SERVER=1
  printf '%s\n' "$SERVER_PID" > "$APP_SUPPORT/server.pid"
}

stop_server() {
  if [ -n "$SERVER_PID" ] && kill -0 "$SERVER_PID" >/dev/null 2>&1; then
    log "stopping server pid $SERVER_PID"
    kill "$SERVER_PID" >/dev/null 2>&1 || true
  fi
}

wait_for_server() {
  for _attempt in {1..60}; do
    if server_ready; then
      return 0
    fi
    sleep 1
  done
  log "server did not become ready"
  /usr/bin/open -a Terminal "$LOG_FILE"
  /usr/bin/osascript -e 'display dialog "Avocet Radar Toolkit did not start. The log has been opened in Terminal." buttons {"OK"} default button "OK"' >/dev/null 2>&1 || true
  exit 1
}

ensure_venv
start_server
wait_for_server
log "opening $BASE_URL"
/usr/bin/open "$BASE_URL"

if [ "$STARTED_SERVER" -eq 1 ] && [ -n "$SERVER_PID" ]; then
  trap stop_server INT TERM
  wait "$SERVER_PID"
fi
