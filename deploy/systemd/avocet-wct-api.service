[Unit]
Description=Avocet UK Radar WCT API
Documentation=/opt/avocet-radar-toolkit/repo/docs/avocet_radar_toolkit_deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=avocet
Group=avocet
WorkingDirectory=/opt/avocet-radar-toolkit/repo
EnvironmentFile=/etc/avocet-wct/avocet-wct.env
ExecStart=/opt/avocet-radar-toolkit/venv/bin/avocet-wct api --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30

# Keep the API service narrow. Batch jobs have their own units.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/avocet-radar-toolkit/data
ReadOnlyPaths=/gws/ssde/j25a/ncas_radar

[Install]
WantedBy=multi-user.target
