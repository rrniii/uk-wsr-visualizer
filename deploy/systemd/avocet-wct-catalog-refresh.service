[Unit]
Description=Refresh Avocet UK Radar WCT catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=avocet
Group=avocet
WorkingDirectory=/opt/avocet-radar-toolkit/repo
EnvironmentFile=/etc/avocet-wct/avocet-wct.env
ExecStart=/opt/avocet-radar-toolkit/venv/bin/avocet-wct catalog build --aggregate-base ${AVOCET_WCT_AGGREGATE_BASE} --output ${AVOCET_WCT_CATALOG} --radar ${AVOCET_WCT_RADAR_FILTER} --year ${AVOCET_WCT_YEAR_FILTER} --metadata-mode ${AVOCET_WCT_CATALOG_METADATA_MODE} --object-store-base ${AVOCET_WCT_OBJECT_STORE_EXTERNAL_BASE}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/avocet-radar-toolkit/data
ReadOnlyPaths=/gws/ssde/j25a/ncas_radar
