[Unit]
Description=Build Avocet UK Radar WCT browser preview frames and tiles
After=avocet-wct-catalog-refresh.service

[Service]
Type=oneshot
User=avocet
Group=avocet
WorkingDirectory=/opt/avocet-radar-toolkit/repo
EnvironmentFile=/etc/avocet-wct/avocet-wct.env
ExecStart=/opt/avocet-radar-toolkit/venv/bin/avocet-wct preview batch --catalog ${AVOCET_WCT_CATALOG} --radar ${AVOCET_WCT_RADAR_FILTER} --preview-dir ${AVOCET_WCT_PREVIEW_DIR} --max-frames-per-item 12 --keep-going
ExecStart=/opt/avocet-radar-toolkit/venv/bin/avocet-wct tile batch --catalog ${AVOCET_WCT_CATALOG} --radar ${AVOCET_WCT_RADAR_FILTER} --tile-dir ${AVOCET_WCT_TILE_DIR} --max-fields-per-item 4 --max-zoom 2 --keep-going
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/avocet-radar-toolkit/data
ReadOnlyPaths=/gws/ssde/j25a/ncas_radar
