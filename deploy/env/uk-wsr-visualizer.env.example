# Copy to /etc/uk-wsr-visualizer/uk-wsr-visualizer.env on the approved service host.
# Keep this file root-readable only if object-store credentials are added here.

UK_WSR_VISUALIZER_DATA_DIR=/opt/uk-wsr-visualizer/data
UK_WSR_VISUALIZER_AGGREGATE_BASE=/gws/ssde/j25a/ncas_radar/vol2/avocet/ukmo-nimrod/raw_h5_data_final/single-site
UK_WSR_VISUALIZER_CATALOG=/opt/uk-wsr-visualizer/data/catalog.json
UK_WSR_VISUALIZER_PREVIEW_DIR=/opt/uk-wsr-visualizer/data/previews
UK_WSR_VISUALIZER_TILE_DIR=/opt/uk-wsr-visualizer/data/tiles
UK_WSR_VISUALIZER_EXPORT_DIR=/opt/uk-wsr-visualizer/data/exports
UK_WSR_VISUALIZER_VALIDATION_DIR=/opt/uk-wsr-visualizer/data/validation/wct
UK_WSR_VISUALIZER_SESSION_DIR=/opt/uk-wsr-visualizer/data/sessions
UK_WSR_VISUALIZER_OBJECT_STORE_MANIFEST=/opt/uk-wsr-visualizer/data/object-store/latest-manifest.json

# Replace TENANCY and bucket names after JASMIN Object Store is provisioned.
UK_WSR_VISUALIZER_OBJECT_STORE_EXTERNAL_BASE=https://TENANCY-o.s3-ext.jc.rl.ac.uk/uk-wsr-visualizer-public
UK_WSR_VISUALIZER_OBJECT_STORE_INTERNAL_BASE=http://TENANCY-o.s3.jc.rl.ac.uk/uk-wsr-visualizer-public
UK_WSR_VISUALIZER_OBJECT_STORE_CONFIG=/etc/uk-wsr-visualizer/object_store.toml

# Optional public metadata fallbacks for object-store/STAC generation.
UK_WSR_VISUALIZER_DATASET_TITLE="UK WSR per-volume ODIM PVOL HDF5"
UK_WSR_VISUALIZER_DATASET_DESCRIPTION="Checked per-volume ODIM PVOL HDF5 objects prepared from UK WSR archive data."
UK_WSR_VISUALIZER_DATASET_LICENSE=proprietary
UK_WSR_VISUALIZER_DATASET_CITATION=
UK_WSR_VISUALIZER_DATASET_PROVIDER_NAME="NCAS Radar Science Group"
UK_WSR_VISUALIZER_DATASET_PROVIDER_URL=
UK_WSR_VISUALIZER_DATASET_CONTACT_EMAIL=
UK_WSR_VISUALIZER_DATASET_TERMS_URL=

# Used by the systemd job templates below.
UK_WSR_VISUALIZER_RADAR_FILTER=
UK_WSR_VISUALIZER_YEAR_FILTER=
UK_WSR_VISUALIZER_CATALOG_METADATA_MODE=fast
