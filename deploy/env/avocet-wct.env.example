# Copy to /etc/avocet-wct/avocet-wct.env on ncas-rsg-cloud-workstation-ssh.
# Keep this file root-readable only if object-store credentials are added here.

AVOCET_WCT_DATA_DIR=/opt/avocet-radar-toolkit/data
AVOCET_WCT_AGGREGATE_BASE=/gws/ssde/j25a/ncas_radar/vol2/avocet/ukmo-nimrod/raw_h5_data_final/single-site
AVOCET_WCT_CATALOG=/opt/avocet-radar-toolkit/data/catalog.json
AVOCET_WCT_PREVIEW_DIR=/opt/avocet-radar-toolkit/data/previews
AVOCET_WCT_TILE_DIR=/opt/avocet-radar-toolkit/data/tiles
AVOCET_WCT_EXPORT_DIR=/opt/avocet-radar-toolkit/data/exports
AVOCET_WCT_VALIDATION_DIR=/opt/avocet-radar-toolkit/data/validation/wct
AVOCET_WCT_SESSION_DIR=/opt/avocet-radar-toolkit/data/sessions
AVOCET_WCT_OBJECT_STORE_MANIFEST=/opt/avocet-radar-toolkit/data/object-store/latest-manifest.json

# Replace TENANCY and bucket names after JASMIN Object Store is provisioned.
AVOCET_WCT_OBJECT_STORE_EXTERNAL_BASE=https://TENANCY-o.s3-ext.jc.rl.ac.uk/avocet-uk-radar-public
AVOCET_WCT_OBJECT_STORE_INTERNAL_BASE=http://TENANCY-o.s3.jc.rl.ac.uk/avocet-uk-radar-public
AVOCET_WCT_OBJECT_STORE_CONFIG=/etc/avocet-wct/object_store.toml

# Optional public metadata fallbacks for object-store/STAC generation.
AVOCET_WCT_DATASET_TITLE="Avocet UK radar aggregate HDF5"
AVOCET_WCT_DATASET_DESCRIPTION="Daily ODIM-like aggregate HDF5 files produced by the Avocet UK radar pipeline."
AVOCET_WCT_DATASET_LICENSE=proprietary
AVOCET_WCT_DATASET_CITATION=
AVOCET_WCT_DATASET_PROVIDER_NAME="NCAS Radar Science Group"
AVOCET_WCT_DATASET_PROVIDER_URL=
AVOCET_WCT_DATASET_CONTACT_EMAIL=
AVOCET_WCT_DATASET_TERMS_URL=

# Used by the systemd job templates below.
AVOCET_WCT_RADAR_FILTER=
AVOCET_WCT_YEAR_FILTER=
AVOCET_WCT_CATALOG_METADATA_MODE=fast
